{
  "name": "fotecta-javascript",
  "version": "1.0.0",
  "description": "Versão em JavaScript do projeto FOTECTA",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/api.test.js",
    "test:browser": "mocha browser/chromeSpecificCaps.spec.js --timeout 120000",
    "test:browser:report": "mocha browser/chromeSpecificCaps.spec.js --timeout 120000 --reporter xunit --reporter-option output=relatorio-selenium-fotecta.xml"
  },
  "license": "Apache-2.0",
  "dependencies": {
