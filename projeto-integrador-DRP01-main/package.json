    "body-parser": "^1.20.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.23.1",
    "sql.js": "^1.13.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "mocha": "12.0.3",
    "selenium-webdriver": "^4.51.0",
    "supertest": "^7.0.0"
  }
}
